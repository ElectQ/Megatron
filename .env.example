# Megatron v0.1.0
# 复制为 .env，deploy.sh 会自动生成密码
#
# 注意：所有 Megatron 的配置项都必须带 MEGATRON_ 前缀，没有前缀的变量会被忽略。

# 运行环境：生产环境只允许 Alembic 管理 schema，日志默认 JSON。
MEGATRON_ENV=production

# 数据库 (默认 SQLite)
# 四条斜杠 = 绝对路径 /app/data/megatron.db（挂载卷上）。
# 三条斜杠是相对 WORKDIR=/app 的路径，会落到卷外面，容器重建即丢数据。
MEGATRON_DATABASE_URL=sqlite+aiosqlite:////app/data/megatron.db

# 安全（Dokploy Secret 中长期固定）。迁移已有 /app/data 时：SESSION / ADMIN /
# INGEST / DAY 四个值要么不填（应用会读取导入卷中的隐藏文件），要么必须填旧值；
# 不能生成新值，否则既有登录、采集端和日刊链接会失效。
# MASTER_KEY 若旧库已有 enc:v1: 密钥，必须复用旧值；新值只会保护之后重新保存的密钥。
MEGATRON_MASTER_KEY=
MEGATRON_SESSION_SECRET=
MEGATRON_ADMIN_TOKEN=
MEGATRON_ADMIN_PASSWORD=
MEGATRON_INGEST_TOKEN=
MEGATRON_DAY_TOKEN=

# 公网域名的「首启种子」。推送里的「查看今日详情」链接是用它拼的。
# 已预置为生产域名；这是个 DB 设置，也可起服务后在 UI「系统设置 → 域名」里改，
# 不用改 env 重部署。（配合 Caddyfile 里的 megatron.qshunter.top 反代 + HTTPS）
MEGATRON_BASE_URL=https://megatron.qshunter.top

# MCP 实时拉取开关：off | backfill | always
# backfill = 仅当当日库里 0 条时才用 MCP 补库，然后照常从库读（过渡期默认）
# 等 Soundwave 改为 HTTP Push 后改成 off
MEGATRON_MCP_LIVE_FETCH=backfill

# 兼容用：git_pull 源的仓库地址 (可选)
MEGATRON_SOUNDWAVE_REPO_URL=

# 日志：同时写 stdout（docker compose logs）和卷上的文件。10MB 轮转，留 5 份。
# production 默认 json；console 适合本地人读。
MEGATRON_LOG_DIR=/app/data/logs
MEGATRON_LOG_FORMAT=json

# 启动：当前单实例由应用迁移数据库；未来拆 scheduler/web 时仅一个服务设为 1。
MEGATRON_RUN_MIGRATIONS=1
# 预发布复制旧 SQLite 卷时设 false，避免与旧站重复执行 scheduler；切流后改回 true。
MEGATRON_SCHEDULER_ENABLED=true
# 仅由 Dokploy 内部反代访问时可保留 *；不要把 8000 直接暴露公网。
MEGATRON_FORWARDED_ALLOW_IPS=*

# LLM (必填)
MEGATRON_DEEPSEEK_API_KEY=

# 钉钉推送 (可选)
MEGATRON_DINGTALK_URL=
MEGATRON_DINGTALK_SECRET=

# 宿主机发布端口 (可选，默认 8010；容器内固定 8000)
# 移到 8010 是为了把宿主机的 8000 留给本机其它 Python 服务。
PORT=8010
